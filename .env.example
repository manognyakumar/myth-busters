# Supabase project (Settings → API). Local defaults are printed by `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never expose. Used by Next.js route handlers to call the game RPCs.
SUPABASE_SERVICE_ROLE_KEY=
# Random secret used to hash recovery codes (e.g. `openssl rand -hex 32`).
RECOVERY_PEPPER=
# Public URL of the deployed game (used for QR codes and metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Local testing only: serve questions/pairs that are still in `draft` review status. Never true in production.
DEV_SERVE_DRAFT=false
# Optional: set to /mythbusters when serving under a subpath of the club site.
NEXT_PUBLIC_BASE_PATH=
